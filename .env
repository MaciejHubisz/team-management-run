# team-management — the one configuration file for this run checkout.
#
# Read by:
#   ./start.sh, ./e2e.sh and scripts/setup-server-as-root.sh (sourced as bash)
#   docker-compose.yml (env_file: every container gets these values)
#   ../team-management/docker-compose.yml (local builds and dev runs)
#
# Keep it valid for both bash and compose: KEY=value, double quotes around any
# value with spaces, no "$", no comments after a value.
#
# Secrets do NOT go here (this file is committed). They go in registry.env,
# which is gitignored, written by scripts/setup-server-as-root.sh with mode 600,
# and loaded after this file:
#   TEAMMGMT_REGISTRY_TOKEN=ghp_…   read:packages token for ghcr.io (required)
#   TEAMMGMT_REGISTRY_USER=…        registry username (default: image owner)
#   DJANGO_SECRET_KEY=…             recommended in production
#   EMAIL_HOST_PASSWORD=… / EMAIL_API_KEY=…   once email is switched on


# --- App identity (used by the shared common/ops scripts) ---------------------
APP_NAME="team-management"
APP_SLUG="team-management"
APP_ENV_PREFIX="TEAMMGMT"
APP_SERVICES="backend web worker backup"
APP_DATA_VOLUMES="teammgmt-pg"
APP_COMPOSE_FILE="docker-compose.yml"
APP_PUBLIC_DIR="/"
APP_VERSION_FILE="VERSION"
APP_MANUAL_FILE="scripts/manual.txt"
APP_EXPORTS_DIR="exports"
APP_DEPLOY_DOC="README.md"
APP_WIPE_IMAGE="docker.io/library/postgres:16-alpine"

# Source repo next to this one: when present, ./start.sh builds images from it.
# Override its location with TEAMMGMT_SRC=/path/to/team-management.
APP_SRC_ENV="TEAMMGMT_SRC"
APP_SRC_DIR="team-management"
APP_BUILD_SCRIPT="build.sh"
APP_BUILD_GUARD="apps"
APP_RUN_SCRIPT="start.sh"
APP_RUN_REPO="team-management-run"


# --- Images -------------------------------------------------------------------
APP_IMAGE_PREFIX="ghcr.io/maciejhubisz/team-management"
APP_REGISTRY="ghcr.io"
# Pin a release instead of :latest, or pull from another registry/owner.
# TEAMMGMT_IMAGE_TAG=0.1.0
# TEAMMGMT_IMAGE_PREFIX=ghcr.io/maciejhubisz/team-management
# TEAMMGMT_REGISTRY=ghcr.io
# Persistent registry auth file (podman default: ~/.config/containers/auth.json).
# TEAMMGMT_AUTHFILE=/home/maciej/.config/containers/auth.json


# --- Container ports ----------------------------------------------------------
# Host port the web container listens on; nginx proxies the public site to it.
TEAMMGMT_PORT=8000
# Host the start script opens and health-checks.
APP_HOST="127.0.0.1"


# --- Public site: domain, nginx, TLS (scripts/setup-server-as-root.sh) --------
# DNS for the domain must point at the server before the certificate is issued.
TEAMMGMT_DOMAIN="odynce.nfy.pl"
# Let's Encrypt expiry notices. Required when TLS is enabled.
TEAMMGMT_TLS_EMAIL="mhubisz91@gmail.com"
# 1 = nginx + certbot TLS certificate, 0 = nginx HTTP-only.
TEAMMGMT_ENABLE_TLS=1
APP_NGINX_SITE_NAME="team-management"
APP_NGINX_TEMPLATE="scripts/admin/nginx-site.conf.template"
# The setup script reads its domain/TLS settings from this file too.
APP_ADMIN_ENV=".env"


# --- Django (URLs, hosts, sessions) -------------------------------------------
# Public base URL used in emailed sign-in and invitation links.
SITE_URL="https://odynce.nfy.pl"
# Comma-separated origins allowed to POST forms (the public https URL).
CSRF_TRUSTED_ORIGINS="https://odynce.nfy.pl"
DJANGO_ALLOWED_HOSTS="*"
DJANGO_DEBUG=false
# Session length in seconds (default 90 days, renewed on every request).
# SESSION_COOKIE_AGE=7776000
# Sign-in link / invitation link lifetime in seconds (defaults: 30 min / 14 days).
# LOGIN_LINK_MAX_AGE=1800
# ACCOUNT_INVITATION_MAX_AGE=1209600


# --- First login on an empty database -----------------------------------------
# A fresh database (./start.sh --force-recreate) holds only this admin.
# TEAMMGMT_ADMIN_EMAIL=admin@team-management.local
# TEAMMGMT_ADMIN_PASSWORD=changeme


# --- Database -----------------------------------------------------------------
# Applied when the database volume is first created; changing them later needs
# ./start.sh --force-recreate (which wipes the data).
POSTGRES_DB=teammgmt
POSTGRES_USER=teammgmt
POSTGRES_PASSWORD=teammgmt


# --- Auto-backups (backup container) ------------------------------------------
# One gzipped export bundle every N seconds into auto-backups/, older ones deleted.
TEAMMGMT_BACKUP_EVERY=3600
TEAMMGMT_BACKUP_KEEP_HOURS=48


# --- Email --------------------------------------------------------------------
# v1 only logs every email (no delivery); these are read now so the provider is
# ready when real sending is switched on.
# EMAIL_PROVIDER: log (default) | smtp | api (HTTP provider: SendGrid, Mailgun, Brevo)
EMAIL_PROVIDER=log
# DEFAULT_FROM_EMAIL="Team <team@example.com>"
# EMAIL_REPLY_TO=
# SMTP
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_USE_TLS=true
# EMAIL_USE_SSL=false
# EMAIL_TIMEOUT=10


# --- Host service and CI deploy (scripts/setup-server-as-root.sh) -------------
APP_SYSTEMD_UNIT="team-management"
APP_SYSTEMD_DESCRIPTION="team-management (amateur hockey operations)"
APP_ALIAS="team-management"
# GitHub repo that gets the deploy key and host variables, and the server login
# the CI deploy job uses over SSH. The deploy host is TEAMMGMT_DOMAIN.
DEPLOY_GH_OWNER="MaciejHubisz"
DEPLOY_GH_REPO="team-management"
DEPLOY_SERVER_USER="maciej"
DEPLOY_PORT=22
