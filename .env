# TEAMMGMT_* overrides for this host. Defaults live in app.conf and in the
# baked image; any value here wins. Uncomment or add lines to change them,
# e.g.:
#
#   TEAMMGMT_IMAGE_PREFIX=ghcr.io/maciejhubisz/team-management
#   TEAMMGMT_IMAGE_TAG=0.1.0

TEAMMGMT_PORT=8000
CSRF_TRUSTED_ORIGINS=https://odynce.nfy.pl

# Email provider (v1 only logs emails; see team-management/.env.example).
# EMAIL_PROVIDER=smtp
# DEFAULT_FROM_EMAIL=Team <team@example.com>
# EMAIL_REPLY_TO=
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true
# EMAIL_USE_SSL=false
# EMAIL_API_KEY=

# First login on an empty database (a fresh/--force-recreate DB holds only this admin).
# TEAMMGMT_ADMIN_EMAIL=admin@team-management.local
# TEAMMGMT_ADMIN_PASSWORD=changeme
