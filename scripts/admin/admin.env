# team-management administrator configuration.
#
# Read by scripts/setup-server-as-root.sh (run as root). Everything here is for
# the public-facing part of the deployment: the nginx reverse proxy and its
# TLS certificate. Leave the app itself to .env and ./start.sh.
#
# This folder is a small, self-contained unit: this file is the config and
# nginx-site.conf.template is the site served. The setup script does the work.

# Public hostname served by nginx. Its DNS must point at this server before
# the TLS certificate can be issued.
TEAMMGMT_DOMAIN="odynce.nfy.pl"

# Port the app listens on locally (matches ./start.sh --port / TEAMMGMT_PORT).
TEAMMGMT_PORT="8000"

# Email for Let's Encrypt expiry notices. Required when TLS is enabled.
TEAMMGMT_TLS_EMAIL="mhubisz91@gmail.com"

# 1 = install nginx, write the site, and obtain a TLS certificate with certbot.
# 0 = install nginx and write the site, but leave it HTTP-only.
TEAMMGMT_ENABLE_TLS="1"
