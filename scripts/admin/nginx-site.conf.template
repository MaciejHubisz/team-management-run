# team-management public site. Served by nginx in front of the Caddy web
# container, which forwards to the Django backend.
#
# The setup script substitutes __DOMAIN__ and __PORT__ from scripts/admin/admin.env.
# This is the HTTP-only block. When TLS is enabled, certbot --nginx adds the
# listen 443 / ssl_* lines and the port 80 -> 443 redirect to the installed copy.
server {
    listen 80;
    server_name __DOMAIN__;

    location / {
        proxy_pass http://127.0.0.1:__PORT__;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
