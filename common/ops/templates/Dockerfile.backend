# Backend image template. Copy to app/backend/Dockerfile and replace APP_ values.
FROM docker.io/library/python:3.12-slim

ARG APP_VERSION=1.0.0
ARG APP_BUILD_COMMIT=
ARG APP_BUILD_DATE=

LABEL org.opencontainers.image.source="https://github.com/owner/myapp"
LABEL org.opencontainers.image.title="MyApp backend"

WORKDIR /app
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    MYAPP_HOST=0.0.0.0 \
    MYAPP_PORT=8000 \
    MYAPP_VERSION=$APP_VERSION

COPY app/backend/requirements.txt /app/backend/requirements.txt
RUN pip install --no-cache-dir -r /app/backend/requirements.txt

# Shared framework package (vendored common/).
COPY common/backend/appcore /app/appcore

COPY VERSION /app/VERSION
COPY app/backend/ /app/backend/
COPY app/database/schema.sql /app/database/schema.sql
RUN mkdir -p /app/exports /app/protocols

EXPOSE 8000
CMD ["python", "-m", "backend"]
